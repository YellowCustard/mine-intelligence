# Mine Monitor — environment configuration.
# Copy to .env and fill in. NEVER commit .env.

# --- Application ---
MM_ENV=dev                       # dev | staging | prod
MM_LOG_LEVEL=INFO
MM_DEFAULT_SITE_TZ=Africa/Harare

# --- Database (PostgreSQL 16 + TimescaleDB) ---
# The API reads MM_DATABASE_URL. The compose db service is seeded from the POSTGRES_* vars.
MM_DATABASE_URL=postgresql+psycopg://minemonitor:minemonitor@db:5432/minemonitor
POSTGRES_USER=minemonitor
POSTGRES_PASSWORD=minemonitor
POSTGRES_DB=minemonitor

# --- MQTT broker (Mosquitto) ---
MM_MQTT_HOST=mqtt
MM_MQTT_PORT=1883
MM_MQTT_TOPIC_PREFIX=mm
MM_MQTT_INGEST_CLIENT_ID=mm-ingestor
# Publisher-side store-and-forward spool (crash-safe local buffer).
MM_SPOOL_PATH=/tmp/mm-spool.sqlite

# --- Rules ---
MM_OFFLINE_THRESHOLD_S=600        # silent this long (while active) = offline
MM_OFFLINE_CHECK_INTERVAL_S=60    # how often the ingestor scans for offline assets
MM_DEFAULT_SITE_ID=kn-zw-01

# --- Auth & bootstrap (M6) ---
# HTTP Basic. On a fresh box (empty users table) an admin is created from these
# on start, so the dashboard is reachable. Leave BOTH blank in production and
# create the first admin with the CLI instead:
#   uv run python -m minemonitor.auth.cli <username> admin
# then set them empty again. Roles: viewer < supervisor < admin, plus device
# (ingest only). Site-scoped users see one site; leave site blank for global.
MM_BOOTSTRAP_ADMIN_USER=
MM_BOOTSTRAP_ADMIN_PASSWORD=
# Password source when the CLI creates a user non-interactively (else it prompts):
# MM_NEW_USER_PASSWORD=

# --- Auth hardening (Phase 2) ---
MM_LOGIN_MAX_FAILURES=5           # lock an account after this many consecutive fails
MM_LOGIN_LOCKOUT_MINUTES=15       # ...for this long
MM_AUTH_VERIFY_CACHE_TTL_S=30     # skip PBKDF2 re-derivation for repeat requests within

# --- Ops / observability (Phase 2) ---
# /healthz is liveness (API + DB); /health is full-system (also MQTT + ingestor).
MM_HEARTBEAT_STALE_S=180          # ingestor heartbeat older than this => /health degraded
# Scheduled backup sidecar (docker compose --profile backup up -d):
MM_BACKUP_INTERVAL_S=86400        # dump every N seconds
MM_BACKUP_KEEP_DAYS=14            # prune dumps older than N days

# --- Retention (M6) — per data class, in days. 0 = keep forever (brief §4). ---
MM_RETAIN_POSITIONS_DAYS=90
MM_RETAIN_METRICS_DAYS=365        # also governs haul cycles (derived analytics)
MM_RETAIN_EVENTS_DAYS=365
MM_RETAIN_AUDIT_DAYS=730          # audit trail outlives the data it describes
MM_RETENTION_INTERVAL_S=86400     # the ingestor runs the deletion job ~daily

# --- API exposure ---
# The API now has auth (M6), but keep it behind TLS. Bind localhost by default;
# set 0.0.0.0 only when a TLS-terminating reverse proxy sits in front.
MM_API_BIND=127.0.0.1

# --- Object storage (MinIO) — present for later evidence clips, unused in M1 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MM_S3_ENDPOINT=http://minio:9000
MM_S3_BUCKET=mine-evidence
