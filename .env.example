# Mine Monitor — environment configuration.
# Copy to .env and fill in. NEVER commit .env.

# --- Optional services ---
# Compose profiles every `docker compose up` (and deploy.sh) starts, comma-separated:
# backup, tls, trackers, sim, evidence, vision. The release installer (deploy/INSTALL.md)
# writes this line; on a git checkout it is unset and profiles are passed with --profile.
# COMPOSE_PROFILES=backup,tls

# --- Application ---
# MM_ENV=prod turns on a startup guard: the API refuses to boot if any known dev
# default is still in place (the sample DB credentials below, or a weak bootstrap
# password). A misconfigured production box fails loudly instead of running on the
# sample secrets. Keep dev/staging on the defaults; set prod deliberately.
MM_ENV=dev                       # dev | staging | prod
MM_LOG_LEVEL=INFO
MM_DEFAULT_SITE_TZ=Africa/Harare

# --- Database (PostgreSQL 16 + TimescaleDB) ---
# The API reads MM_DATABASE_URL. The compose db service is seeded from the POSTGRES_* vars.
# PRODUCTION: replace minemonitor:minemonitor with a strong, unique password — the
# MM_ENV=prod guard rejects these sample credentials.
MM_DATABASE_URL=postgresql+psycopg://minemonitor:minemonitor@db:5432/minemonitor
POSTGRES_USER=minemonitor
POSTGRES_PASSWORD=minemonitor
POSTGRES_DB=minemonitor
# Host address the database port (5432) is published on. Docker-published ports bypass ufw, so
# this, not the firewall, keeps the database off the network. Every service in the stack reaches
# it over the compose network; leave it on loopback.
MM_DB_BIND=127.0.0.1

# --- MQTT broker (Mosquitto) ---
MM_MQTT_HOST=mqtt
MM_MQTT_PORT=1883
MM_MQTT_TOPIC_PREFIX=mm
MM_MQTT_INGEST_CLIENT_ID=mm-ingestor
# Host address the broker port (1883) is published on. Docker-published ports bypass ufw, so this
# is what keeps the broker off the network. Loopback unless a device on another box publishes over
# MQTT (a vision edge node with MM_EDGE_TRANSPORT=mqtt); then this host's device-VLAN address, and
# only with broker authentication on (below).
MM_MQTT_BIND=127.0.0.1
# Broker authentication. Leave BOTH blank for a local/dev/demo broker that accepts
# anonymous connections. On a real site, set a service account: internal clients
# (ingestor + simulator/Teltonika publishers) authenticate with it. Setting
# MM_MQTT_USERNAME is what switches the broker to docker/mosquitto.auth.conf
# (allow_anonymous false) on every `docker compose up`; deploy.sh writes the password +
# ACL files that config needs and checks the broker refuses a client with no login.
# MM_ENV=prod requires MM_MQTT_USERNAME.
MM_MQTT_USERNAME=
MM_MQTT_PASSWORD=
# Overrides the broker config chosen above. Leave unset on a site: pointing it at the
# anonymous config with MM_MQTT_USERNAME set makes deploy.sh fail.
# MM_MOSQUITTO_CONF=./docker/mosquitto.conf
# Strict device provisioning: accept MQTT telemetry only for assets with an enabled
# device row (provision via POST /sites/{id}/devices, which returns a one-time broker
# secret). The broker password + ACL files, generated from that table
# (python -m minemonitor.devices.broker_config), authenticate each device and confine
# it to its own topic. Off by default so a fresh/demo install ingests without
# provisioning; regenerate the files and `kill -HUP 1` the broker after device changes.
MM_MQTT_REQUIRE_REGISTERED_DEVICE=false
# Publisher-side store-and-forward spool (crash-safe local buffer).
MM_SPOOL_PATH=/tmp/mm-spool.sqlite

# --- Rules ---
MM_OFFLINE_THRESHOLD_S=600        # silent this long (while active) = offline
MM_VISION_CAMERA_STALE_S=300      # vision: commissioned camera silent this long = camera_offline
MM_OFFLINE_CHECK_INTERVAL_S=60    # how often the ingestor scans for offline assets
MM_MAX_FUTURE_SKEW_S=120          # reject fixes whose device time is this far ahead of the server
MM_DEFAULT_SITE_ID=kn-zw-01
# Access-control random search (FP-07). 0 = off; else the % of gate passages selected
# for a physical search when the source did not. A selected search not completed within
# the grace window escalates (search_missed alarm) on the maintenance tick.
MM_ACCESS_SEARCH_RATE_PERCENT=0
MM_ACCESS_SEARCH_GRACE_S=900
# Live Dahua gate/turnstile event poller (FP-07). Blank url = off (the simulator and the
# HTTP-ingest endpoint still work). When set, the ingestor polls this API each maintenance
# tick and ingests new access events. Verify the vendor response shape against the real
# Dahua backdoor-API spec before production.
MM_ACCESS_GATE_URL=
MM_ACCESS_GATE_TOKEN=
MM_ACCESS_GATE_SOURCE_SYSTEM=dahua_gate
MM_ACCESS_GATE_OVERLAP_S=30       # refetch this far behind the last event; dedup drops overlap
# Live DSE generator poller (FP-11). Blank host = off (the simulator + HTTP-ingest endpoint
# still work). When set, the ingestor polls the DSE controller(s) over Modbus TCP and ingests
# readings. Confirm the register map per DSE model on site before enabling.
MM_GENERATOR_MODBUS_HOST=
MM_GENERATOR_MODBUS_PORT=502
# Laboratory anomaly bounds (FP-08). JSON mapping element -> [min, max] in the result's unit;
# a measured value outside its range raises an advisory lab_anomaly alarm for review (flag,
# never alter). Blank = off. e.g. MM_LAB_ANOMALY_BOUNDS={"Au": [0, 100], "Ag": [0, 500]}
MM_LAB_ANOMALY_BOUNDS=

# --- Auth & bootstrap (M6) ---
# HTTP Basic. On a fresh box (empty users table) an admin is created from these
# on start, so the dashboard is reachable. Leave BOTH blank in production and
# create the first admin with the CLI instead:
#   uv run python -m minemonitor.auth.cli <username> admin
# then set them empty again. Roles: viewer < supervisor < admin, plus device
# (ingest only). Site-scoped users see one site; leave site blank for global.
MM_BOOTSTRAP_ADMIN_USER=
MM_BOOTSTRAP_ADMIN_PASSWORD=
# Password source when the CLI creates a user non-interactively (else it prompts):
# MM_NEW_USER_PASSWORD=

# --- Auth hardening (Phase 2) ---
MM_LOGIN_MAX_FAILURES=5           # lock an account after this many consecutive fails
MM_LOGIN_LOCKOUT_MINUTES=15       # ...for this long
MM_AUTH_VERIFY_CACHE_TTL_S=30     # skip PBKDF2 re-derivation for repeat requests within

# --- Notification egress (advisory alerts) ---
# Nobody watches a dashboard 24/7 at a remote site, so qualifying events are pushed
# out via a crash-safe store-and-forward outbox. Off by default: leave min-severity
# blank. Order: info < warning < critical. Set at least one channel (webhook, SMTP,
# and/or WhatsApp). The payload carries only event.v1 fields — never operator names.
MM_NOTIFY_MIN_SEVERITY=            # "" (off) | info | warning | critical
MM_NOTIFY_WEBHOOK_URL=             # POST the event JSON here (e.g. a chat/incident hook)
MM_NOTIFY_SMTP_HOST=               # blank = no email
MM_NOTIFY_SMTP_PORT=587
MM_NOTIFY_SMTP_USER=
MM_NOTIFY_SMTP_PASSWORD=
MM_NOTIFY_SMTP_STARTTLS=true
MM_NOTIFY_EMAIL_FROM=
MM_NOTIFY_EMAIL_TO=                # comma-separated recipients
# WhatsApp channel (off unless both URL and recipients set). The advisory line carries
# only [severity] site: summary (advisory) — no operator names.
MM_NOTIFY_WHATSAPP_URL=            # WhatsApp Cloud API messages endpoint, e.g. https://graph.facebook.com/v20.0/<phone-id>/messages
MM_NOTIFY_WHATSAPP_TOKEN=          # bearer token for the messages endpoint
MM_NOTIFY_WHATSAPP_TO=             # comma-separated recipient numbers, E.164 (e.g. +263771234567)
MM_NOTIFY_MAX_ATTEMPTS=5           # then the row is marked failed (visible in the queue)
MM_NOTIFY_RETRY_BASE_S=60          # exponential backoff base between delivery attempts

# --- Ops / observability (Phase 2) ---
# /healthz is liveness (API + DB); /health is full-system (also MQTT + ingestor).
MM_HEARTBEAT_STALE_S=180          # ingestor heartbeat older than this => /health degraded
# Scheduled backup sidecar (docker compose --profile backup up -d):
MM_BACKUP_INTERVAL_S=86400        # dump every N seconds
MM_BACKUP_KEEP_DAYS=14            # prune dumps older than N days

# --- Retention (M6) — per data class, in days. 0 = keep forever (brief §4). ---
MM_RETAIN_POSITIONS_DAYS=90
MM_RETAIN_METRICS_DAYS=365        # also governs haul cycles (derived analytics)
MM_RETAIN_EVENTS_DAYS=365
MM_RETAIN_ANNOTATIONS_DAYS=365    # incidents (closed only), delay classifications, handovers
MM_RETAIN_AUDIT_DAYS=730          # audit trail outlives the data it describes
MM_RETAIN_VISION_OBSERVATIONS_DAYS=30  # vision per-frame observations (recompute basis)
MM_RETAIN_VISION_HEALTH_DAYS=30   # vision node/camera health telemetry
MM_RETENTION_INTERVAL_S=86400     # the ingestor runs the deletion job ~daily

# --- API exposure ---
# The API has auth (M6), but Basic credentials must ride TLS. Keep loopback: the bundled
# Caddy (tls profile) and a reverse proxy on this host both reach it without leaving the box.
# A proxy on another host would send the credentials to port 8000 over plain HTTP.
MM_API_BIND=127.0.0.1

# --- TLS reverse proxy (docker compose --profile tls up -d) ---
# Caddy terminates HTTPS in front of the API. Default is Caddy's internal CA for an
# on-prem host reached over the LAN/VPN. For a PUBLIC domain with a real certificate,
# set MM_SITE_DOMAIN to that hostname and MM_TLS_EMAIL to the ACME account email: Caddy
# then gets a Let's Encrypt certificate (ports 80 and 443 reachable). Caddy reaches the API
# over the compose network, so MM_API_BIND can stay 127.0.0.1 — only Caddy faces the world.
# Several addresses: comma-separated and quoted, e.g. MM_SITE_DOMAIN="10.20.0.5, minebox".
MM_SITE_DOMAIN=localhost
MM_TLS_EMAIL=

# --- Teltonika TCP listener (real GNSS trackers, docker compose --profile trackers) ---
# Trackers speak Codec 8/8E over raw TCP on this port. A tracker's IMEI is its device_id:
# provision it (POST /sites/{id}/devices, device_id=<IMEI>) and the listener routes it to
# that device's asset. With MM_MQTT_REQUIRE_REGISTERED_DEVICE=true an unknown or disabled
# IMEI is refused at the handshake. See deploy/COMMISSIONING.md.
MM_TELTONIKA_PORT=5027
# Host address the listener is published on. Trackers must reach it, so the default is every
# interface. Docker-published ports bypass ufw: to keep it off other networks, set the address the
# trackers arrive on (for a private APN, that interface's address).
MM_TELTONIKA_BIND=0.0.0.0
# Close a connection that stops sending for this long (seconds); trackers report far more
# often, so a lapse this long means a dead/half-open socket.
MM_TELTONIKA_IDLE_TIMEOUT_S=900

# --- Evidence object store (SeaweedFS, S3 API; compose profile "evidence") ---
# Opt-in: docker compose --profile evidence up -d. Nothing in Phase 1 writes evidence; only the
# vision edge node does, with MM_EDGE_EVIDENCE=s3. With the profile on, the store refuses to start
# unless the admin pair below and the edge pair (MM_EDGE_S3_ACCESS_KEY / MM_EDGE_S3_SECRET_KEY,
# vision section) are set: keys >= 3 and secrets >= 16 characters of A-Z a-z 0-9 . _ ~ + / = -
# The admin identity has full access; the edge identity may only write into MM_EDGE_S3_BUCKET.
MM_OBJECTSTORE_ADMIN_KEY=
MM_OBJECTSTORE_ADMIN_SECRET=
# Host address the S3 port (8333) is published on. Loopback unless a vision edge node on another
# box uploads here; then the LAN address, behind TLS if the link leaves the site LAN.
MM_OBJECTSTORE_BIND=127.0.0.1

# --- Vision edge node (vision V5; compose profile "vision") ---
# The node's device account on the core API (create: python -m minemonitor.auth.cli <user> device
# --site <site>). It pulls its config and posts vision records with it.
MM_EDGE_SITE_ID=kn-zw-01
MM_EDGE_NODE_ID=edge-01
# Plain http only on the same box (localhost or the compose service name). A core on another
# host must be https://… (the device password rides every request). For Caddy's internal CA,
# mount its root certificate into the node and set SSL_CERT_FILE to it.
MM_EDGE_CORE_URL=http://api:8000
MM_EDGE_USERNAME=
MM_EDGE_PASSWORD=
# Camera streams, JSON {"<camera_id>": "<rtsp url>"}. URLs carry camera passwords: keep them here
# (never in the repo, never in the core). Use each camera's substream — 2–5 fps is analysed.
# MM_EDGE_STREAMS={"01J...":"rtsp://viewer:CHANGE_ME@10.20.0.5:554/cam/realmonitor?channel=1&subtype=1"}
MM_EDGE_STREAMS=
MM_EDGE_MODEL=yolox-nano          # yolox-nano (default, CPU) | yolox-s
MM_EDGE_SAMPLE_FPS=5
# Where weights and node state live. Defaults for running outside Docker; the vision image fixes
# them to /models (read-only mount) and /var/lib/mm-edge (the vision_state volume).
# MM_EDGE_MODELS_DIR=var/models
# MM_EDGE_STATE_DIR=var/edge
MM_EDGE_CONFIG_REFRESH_S=300      # how often the node re-pulls its vision config
MM_EDGE_DRAIN_INTERVAL_S=5        # how often the outbox is delivered to the core
MM_EDGE_HEARTBEAT_S=60            # node/camera health cadence
MM_EDGE_NO_SIGNAL_AFTER_S=15      # no frame this long = camera reports no_signal
MM_EDGE_OBSERVATION_KEEP_HOURS=72 # per-frame observations kept on the node (recompute window)
# Frozen-picture detection; tune on commissioning if a static, compressed view reads "no_signal".
MM_EDGE_FROZEN_DIFF=0.5
MM_EDGE_FROZEN_FRAMES=25
# http (default) posts to the API; mqtt publishes at QoS 1 as a "vision-edge" broker device.
MM_EDGE_TRANSPORT=http
MM_EDGE_MQTT_HOST=mqtt
MM_EDGE_MQTT_PORT=1883
MM_EDGE_MQTT_PREFIX=mm
MM_EDGE_MQTT_USERNAME=
MM_EDGE_MQTT_PASSWORD=
# Evidence stills (one per alarm). edge = kept on the node only (bounded ring); s3 = also
# uploaded to the evidence object store under <site>/vision/…; off = none. Stills show people:
# personal data.
MM_EDGE_EVIDENCE=edge
MM_EDGE_EVIDENCE_MAX_ITEMS=500
MM_EDGE_EVIDENCE_MAX_AGE_DAYS=7
# The default name resolves only on the core's compose network. A node on a separate edge box uses
# http://<core LAN address>:8333, and the core sets MM_OBJECTSTORE_BIND to that address.
MM_EDGE_S3_ENDPOINT=http://objectstore:8333
MM_EDGE_S3_BUCKET=mine-evidence
MM_EDGE_S3_ACCESS_KEY=
MM_EDGE_S3_SECRET_KEY=
MM_EDGE_S3_REGION=us-east-1
