# Keep the build context small and free of secrets/weights. Images COPY only what they need,
# but everything not listed here is still sent to the Docker daemon on every build.
.git
.venv
.env
.env.*
!.env.example
var/
backups/
docker/mosquitto/
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov/
