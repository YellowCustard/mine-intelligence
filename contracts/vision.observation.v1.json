{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigenstatesystems.com/contracts/vision.observation.v1.json",
  "title": "vision.observation.v1",
  "description": "What a first-party model saw in one frame (docs/VISION_BUILD_GATE.md §4.1). Perception only — provenance is always 'observed'; no operational conclusion, no identity, no frame bytes. Lab/on-demand transport: the edge stores these locally and the core pulls slices (§5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_id",
    "site_id",
    "node_id",
    "camera_id",
    "ts",
    "frame_id",
    "model",
    "objects",
    "advisory"
  ],
  "properties": {
    "schema": {
      "const": "vision.observation.v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic per (camera, frame) — replay is idempotent."
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "description": "The edge node that produced this record."
    },
    "camera_id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Edge/source capture time (timezone-aware)."
    },
    "received_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Core arrival time, stamped at ingest; the gap to ts detects buffered backfill."
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "calibration_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "advisory": {
      "const": true
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "description": "Normalised image box; x1<x2 and y1<y2 (checked at the runtime boundary).",
      "properties": {
        "x1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ground_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis"
      ],
      "properties": {
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "basis": {
          "enum": [
            "homography",
            "unknown"
          ],
          "description": "unknown = no calibration: no distance claims."
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "class",
        "confidence",
        "bbox",
        "provenance"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 3,
          "description": "Per-camera temporal identity '<camera_id>:<n>' — never an asset id, never a person's identity."
        },
        "class": {
          "enum": [
            "person",
            "haul_truck",
            "light_vehicle",
            "loader",
            "excavator",
            "dozer",
            "grader",
            "drill",
            "water_truck",
            "service_truck",
            "bus"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "ground_point": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ground_point"
            }
          ]
        },
        "zone_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operational zones whose image-zone contains the object's foot point."
        },
        "provenance": {
          "const": "observed"
        }
      }
    }
  }
}
